rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isProjectOwner(projectData) {
      return isAuthenticated() && projectData.ownerId == request.auth.uid;
    }

    function isProjectCollaborator(projectData) {
      return isAuthenticated() && (
        projectData.ownerId == request.auth.uid ||
        (projectData.collaborators != null && projectData.collaborators.hasAny([request.auth.uid])) ||
        (projectData.collaboratorIds != null && projectData.collaboratorIds.hasAny([request.auth.uid])) ||
        (request.auth.token.email != null && projectData.collaborators != null && projectData.collaborators.hasAny([request.auth.token.email]))
      );
    }

    // 1. User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // 2. Projects & Subcollections
    match /projects/{projectId} {
      allow read: if resource.data.isPublic == true ||
                   isProjectCollaborator(resource.data);

      allow create: if isAuthenticated() && 
                    request.resource.data.ownerId == request.auth.uid;

      allow update: if isAuthenticated() && (
                     isProjectCollaborator(resource.data) ||
                     request.resource.data.ownerId == request.auth.uid
                   );

      allow delete: if isAuthenticated() && 
                    resource.data.ownerId == request.auth.uid;

      // Real-time Collaborative Operational Edits
      match /operations/{operationId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }

      // Live Presence Heartbeats
      match /presence/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // Version History Snapshots
      match /versions/{versionId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Threaded Comments & Annotations
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuthenticated();

        // Replies in thread
        match /replies/{replyId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
          allow update, delete: if isAuthenticated();
        }
      }

      // Collaborators List
      match /collaborators/{collabId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Approvals & Audit Sign-offs
      match /approvals/{approvalId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }
    }

    // 3. Cloud Presets Synchronization
    match /presets/{presetId} {
      allow read: if resource.data.isPublic == true || (isAuthenticated() && resource.data.ownerId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // 4. Cloud Rendering Jobs Queue
    match /render_jobs/{jobId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource == null);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 5. Shared Public Links
    match /shared_projects/{shareId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // 6. Plugins & Extensions Ecosystem
    match /plugins/{pluginId} {
      allow read: if resource.data.isPublic == true || (isAuthenticated() && resource.data.authorId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // 7. System Health Check
    match /system/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
